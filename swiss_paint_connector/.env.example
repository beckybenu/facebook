# Copie ce fichier en ".env" (ou passe les variables au lancement).

# Dossier où ton partage WD est monté sur la machine (voir README).
WD_ROOT=/mnt/wd

# Jeton d'accès secret (invente une longue chaîne). À coller aussi dans l'app.
CONNECTOR_TOKEN=change-moi-avec-une-longue-chaine-secrete

# Port local (laisse 8787 sauf besoin).
PORT=8787
